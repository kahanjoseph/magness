---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../data/services';
const contactEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true' && Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
<BaseLayout>
  <section class="hero pt-[calc(6.5rem*var(--space-scale))] pb-(--space-section) max-[1000px]:pt-[calc(5rem*var(--space-scale))] max-[1000px]:pb-[calc(6rem*var(--space-scale))] max-[700px]:pt-[calc(3.5rem*var(--space-scale))] max-[700px]:pb-[calc(4.5rem*var(--space-scale))]" aria-labelledby="hero-heading">
    <div class="container">
    <p data-hero style="--i:0" class="eyebrow mb-[calc(2rem*var(--space-scale))] text-[.72rem] font-[650] tracking-[.13em] text-accent uppercase">Independent software consulting <span class="mx-[calc(.55rem*var(--space-scale))] text-brand-marker" aria-hidden="true">/</span> Built for the way you work</p>
    <h1 id="hero-heading" data-hero style="--i:1" class="text-[calc(clamp(3.4rem,7vw,6.75rem)*var(--heading-scale))] leading-[.99] font-[550] tracking-[-.065em] max-[700px]:text-[calc(clamp(2.9rem,10vw,4.3rem)*var(--heading-scale))] max-[700px]:leading-[1.04] max-[700px]:tracking-[-.055em]">Software built<br class="max-[700px]:hidden" /> around <em class="signature inline-block tracking-[-.04em] whitespace-nowrap max-[700px]:whitespace-normal">your business.</em></h1>
    <div class="hero-body mt-[calc(3rem*var(--space-scale))] max-[700px]:mt-[calc(2rem*var(--space-scale))]">
      <div>
        <p data-hero style="--i:2" class="max-w-[35rem] text-xl leading-[1.55] max-[700px]:max-w-[32rem] max-[700px]:text-[1.0625rem]">Build the tools you need, connect the systems you rely on, and simplify the work in between. MAGNESS provides custom software development with a direct line to the developer building your solution.</p>
        <div data-hero style="--i:3" class="hero-actions mt-[calc(2rem*var(--space-scale))] flex flex-wrap gap-[calc(.75rem*var(--space-scale))] max-[700px]:mt-[calc(1.5rem*var(--space-scale))] [&_.button]:min-w-[15.5rem] max-[700px]:[&_.button]:min-w-0 max-[700px]:[&_.button]:flex-[1_1_auto]">
          <a class="button" href="#contact">Discuss your project</a>
          <a class="button button-outline" href="#services">Explore services</a>
        </div>
      </div>
    </div>
    </div>
  </section>

  <section id="services" class="services section-shell bg-primary py-(--space-section) text-primary-foreground [--ring:var(--brand-bright)] max-[1000px]:py-[calc(5rem*var(--space-scale))] max-[700px]:py-[calc(3.5rem*var(--space-scale))]" aria-labelledby="services-heading">
    <div class="container">
      <div class="split services-intro items-end pb-[calc(5rem*var(--space-scale))] max-[700px]:gap-[calc(1.5rem*var(--space-scale))] max-[700px]:pb-[calc(2.5rem*var(--space-scale))]" data-reveal>
        <h2 id="services-heading" class="max-[700px]:[&_br]:hidden">What does your<br /> business need<br /> <em class="signature whitespace-nowrap">to do next?</em></h2>
        <p class="text-lg text-inverse-muted max-[700px]:text-base">Whether you’re starting with an idea or improving an existing system, the first step is understanding what you need the software to do.</p>
      </div>
      <div class="service-list">
        {services.map((service) => (
          <article class="service-row split border-t border-inverse-border pt-[calc(2.5rem*var(--space-scale))] pb-[calc(2.75rem*var(--space-scale))] max-[700px]:gap-(--space-md) max-[700px]:pt-[calc(1.75rem*var(--space-scale))] max-[700px]:pb-(--space-lg)" data-reveal>
            <div>
            <h3 class="relative pl-[calc(1.45rem*var(--space-scale))] before:absolute before:top-[.65rem] before:left-0 before:h-[.55rem] before:w-[.55rem] before:rounded-[1px] before:bg-brand-marker before:content-[''] max-[700px]:pl-[calc(1.25rem*var(--space-scale))] max-[700px]:before:top-2">{service.title}</h3>
              <p class="mt-[calc(.9rem*var(--space-scale))] pl-[calc(1.45rem*var(--space-scale))] text-[.8125rem] text-inverse-muted max-[700px]:mt-[calc(.5rem*var(--space-scale))] max-[700px]:pl-[calc(1.25rem*var(--space-scale))]">{service.examples.join(' · ')}</p>
            </div>
            <div>
              <p class="text-lg leading-[1.6] max-[700px]:text-base">{service.description}</p>
              <a class="text-link mt-[calc(1.25rem*var(--space-scale))] text-brand-bright max-[700px]:mt-(--space-md)" href="#contact">{service.cta}<span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="services-cta mt-[calc(3.5rem*var(--space-scale))] flex flex-wrap items-center gap-[calc(1.5rem*var(--space-scale))] border-t border-inverse-border pt-[calc(2.25rem*var(--space-scale))] max-[700px]:mt-[calc(1.25rem*var(--space-scale))] max-[700px]:gap-(--space-md) max-[700px]:pt-[calc(1.75rem*var(--space-scale))]" data-reveal>
        <p class="text-lg font-medium">Not sure where your project fits?</p>
        <a class="button button-accent" href="#contact">Discuss your project</a>
      </div>
    </div>
  </section>

  <section id="about" class="about container split pt-(--space-section) pb-[calc(7.5rem*var(--space-scale))] max-[1000px]:py-[calc(5rem*var(--space-scale))] max-[700px]:py-[calc(4rem*var(--space-scale))]" aria-labelledby="about-heading">
    <h2 id="about-heading" data-reveal>Work directly with<br /> <em class="signature whitespace-nowrap">your developer.</em></h2>
    <div class="about-copy" data-reveal>
      <p class="about-lead text-2xl leading-[1.5] tracking-[-.02em] max-[700px]:text-[1.1875rem]">I bring a decade of experience building business applications, integrations, and automation. At MAGNESS, you work with me to define the requirements, make technical decisions, and develop the solution.</p>
      <p class="experience mt-(--space-lg) mb-[calc(1.5rem*var(--space-scale))] max-w-[37rem] text-muted-foreground max-[700px]:mt-[calc(1.5rem*var(--space-scale))] max-[700px]:mb-[calc(1.25rem*var(--space-scale))]">I build custom business applications, connect systems, and automate workflows. My experience spans CRMs and ERPs, reporting dashboards, e-commerce, web scraping, and AI integrations.</p>
      <a class="text-link text-accent" href="#contact">Let’s talk about your project<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="contact section-shell bg-secondary py-(--space-section) max-[1000px]:py-[calc(5rem*var(--space-scale))] max-[700px]:py-[calc(3.5rem*var(--space-scale))]" aria-labelledby="contact-heading">
    <div class="container split">
      <div class="contact-intro" data-reveal>
        <h2 id="contact-heading" class="max-[700px]:[&_br]:hidden">Tell me what you<br /> want to build—<br /><em class="signature">or what needs<br /> to work better.</em></h2>
        <p class="mt-[calc(1.75rem*var(--space-scale))] max-w-[27rem] text-[1.0625rem] max-[700px]:mt-[calc(1.25rem*var(--space-scale))]">{contactEnabled ? 'Share your idea or the process you would like to improve, and I’ll get back to you.' : 'The contact form is coming soon.'}</p>
      </div>
      {contactEnabled && <ContactForm />}
    </div>
  </section>
</BaseLayout>
<script>
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  if ('IntersectionObserver' in window && !motionPreference.matches) {
    const observer = new IntersectionObserver((entries) => {
      // Items that enter in the same frame cascade instead of appearing at once.
      entries.filter((entry) => entry.isIntersecting).forEach((entry, index) => {
        const target = entry.target as HTMLElement;
        target.style.setProperty('--reveal-delay', `calc(var(--stagger) * ${index})`);
        target.classList.remove('is-waiting');
        observer.unobserve(target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0 });
    for (const section of sections) {
      if (section.getBoundingClientRect().top > window.innerHeight) {
        section.classList.add('is-waiting');
        observer.observe(section);
        section.addEventListener('focusin', () => {
          section.classList.remove('is-waiting');
          observer.unobserve(section);
        }, { once: true });
      }
    }
    motionPreference.addEventListener('change', (event) => {
      if (event.matches) {
        sections.forEach((section) => section.classList.remove('is-waiting'));
        observer.disconnect();
      }
    });
  }
</script>
