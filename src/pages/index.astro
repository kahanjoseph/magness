---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../data/services';
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-heading">
    <h1 id="hero-heading">Software built<br class="desktop-break" /> around <em>your business.</em></h1>
    <p>Build the tools you need, connect the systems you rely on, and simplify the work in between. MAGNESS provides custom software development with a direct line to the developer building your solution.</p>
    <div class="hero-actions">
      <a class="button" href="#contact">Discuss Your Project</a>
      <a class="button button-outline" href="#services">Explore Services</a>
    </div>
  </section>

  <section id="services" class="services section-shell" aria-labelledby="services-heading">
    <div class="container">
      <div class="split services-intro">
        <h2 id="services-heading">What does your<br /> business need<br /> to do next?</h2>
        <p>Whether you’re starting with an idea or improving an existing system, the first step is understanding what you need the software to do.</p>
      </div>
      <div class="service-list">
        {services.map((service) => (
          <article class="service-row split">
            <h3>{service.title}</h3>
            <div>
              <p>{service.description}</p>
              <a class="text-link" href="#contact">{service.cta}<span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="services-cta">
        <p>Not sure where your project fits?</p>
        <a class="button button-accent" href="#contact">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <section id="about" class="about container split" aria-labelledby="about-heading">
    <h2 id="about-heading">Work directly with<br /> your developer.</h2>
    <div class="about-copy">
      <p class="about-lead">I bring around ten years of experience building business applications, integrations, and automation. At MAGNESS, you work with me to define the requirements, make technical decisions, and develop the solution.</p>
      <p class="experience">My experience in previous roles includes custom CRMs, order and production automation, reporting across multiple data sources, investor-facing dashboards, and document extraction with AI.</p>
      <a class="text-link" href="#contact">Let’s talk about your project<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="contact section-shell" aria-labelledby="contact-heading">
    <div class="container split">
      <div class="contact-intro">
        <h2 id="contact-heading">Tell me what you<br /> want to build—<br />or what needs<br /> to work better.</h2>
        <p>You don’t need a technical specification to start. Share the idea, the challenge, or the process you’d like to improve, and we can work through the next step.</p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: 6.5rem 7rem; }
  h1 { font-size: clamp(3.4rem, 7vw, 6.75rem); line-height: 0.99; letter-spacing: -0.065em; font-weight: 550; }
  h1 em { color: var(--accent); font-family: var(--font-editorial); font-weight: 400; letter-spacing: -0.04em; white-space: nowrap; }
  .hero > p { max-width: 35rem; margin-top: 4.5rem; font-size: 1.25rem; line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-actions .button { min-width: 15.5rem; }
  .services { padding-block: 7rem; background: var(--primary); color: var(--primary-foreground); --ring: var(--brand-bright); }
  .services-intro { align-items: end; padding-bottom: 5rem; }
  .services-intro > p { color: var(--inverse-muted); font-size: 1.125rem; }
  .service-row { padding-block: 2.5rem 2.75rem; border-top: 1px solid var(--inverse-border); }
  .service-row h3 { position: relative; padding-left: 1.45rem; }
  .service-row h3::before { content: ''; position: absolute; width: 0.55rem; height: 0.55rem; border-radius: 1px; left: 0; top: 0.65rem; background: var(--brand-marker); }
  .service-row p { font-size: 1.125rem; line-height: 1.6; }
  .service-row .text-link { margin-top: 1.25rem; color: var(--brand-bright); }
  .services-cta { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 3.5rem; padding-top: 2.25rem; border-top: 1px solid var(--inverse-border); }
  .services-cta p { font-size: 1.125rem; font-weight: 500; }
  .about { padding-block: 7rem 7.5rem; }
  .about-lead { font-size: 1.5rem; line-height: 1.5; letter-spacing: -0.02em; }
  .experience { margin-block: 2rem 1.5rem; max-width: 37rem; color: var(--muted-foreground); }
  .contact { padding-block: 7rem; background: var(--secondary); }
  .contact-intro p { max-width: 27rem; margin-top: 1.75rem; font-size: 1.0625rem; }
  @media (max-width: 1000px) {
    .hero { padding-block: 5rem 6rem; }
    .services, .contact { padding-block: 5rem; }
    .about { padding-block: 5rem; }
  }
  @media (max-width: 700px) {
    .hero { padding-block: 3.5rem 4.5rem; }
    h1 { font-size: clamp(2.9rem, 10vw, 4.3rem); letter-spacing: -0.055em; line-height: 1.04; }
    h1 em { white-space: normal; }
    .desktop-break { display: none; }
    .hero > p { margin-top: 2rem; font-size: 1.0625rem; max-width: 32rem; }
    .hero-actions { margin-top: 1.5rem; }
    .hero-actions .button { min-width: 0; flex: 1 1 auto; }
    .services, .contact { padding-block: 3.5rem; }
    .services-intro { gap: 1.5rem; padding-bottom: 2.5rem; }
    .services-intro h2 br { display: none; }
    .services-intro > p, .service-row p { font-size: 1rem; }
    .service-row { gap: 1rem; padding-block: 1.75rem 2rem; }
    .service-row h3 { padding-left: 1.25rem; }
    .service-row h3::before { top: 0.5rem; }
    .service-row .text-link { margin-top: 1rem; }
    .services-cta { margin-top: 1.25rem; padding-top: 1.75rem; gap: 1rem; }
    .about { padding-block: 4rem; }
    .about-lead { font-size: 1.1875rem; }
    .experience { margin-block: 1.5rem 1.25rem; }
    .contact-intro h2 br { display: none; }
    .contact-intro p { margin-top: 1.25rem; }
  }
</style>
