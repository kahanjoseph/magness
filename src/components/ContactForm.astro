---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<form id="project-form" class="contact-form" action="/api/contact" method="post">
  <div class="field-pair">
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-error" />
      <p id="name-error" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" />
      <p id="email-error" class="field-error" hidden></p>
    </div>
  </div>
  <div class="field">
    <label for="contact-company">Company <span>(optional)</span></label>
    <input id="contact-company" name="company" autocomplete="organization" maxlength="120" aria-describedby="company-error" />
    <p id="company-error" class="field-error" hidden></p>
  </div>
  <div class="field">
    <label for="contact-message">Project description</label>
    <textarea id="contact-message" name="message" rows="5" required minlength="10" maxlength="5000" placeholder="What would you like to build or improve?" aria-describedby="message-error"></textarea>
    <p id="message-error" class="field-error" hidden></p>
  </div>
  <div class="honeypot" aria-hidden="true" inert>
    <label for="contact-website">Leave this field empty</label>
    <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
  </div>
  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible"></div>}
  <button class="button" type="submit">Send Project Details</button>
  <p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
  <p class="privacy-note">Your details are used to respond to your enquiry. <a href="/privacy/">Privacy</a></p>
  {siteKey && <noscript><p>Please enable JavaScript to complete the spam protection and send your enquiry.</p></noscript>}
</form>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  const form = document.querySelector<HTMLFormElement>('#project-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && status && button) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      status.hidden = true;
      form.querySelectorAll<HTMLElement>('.field-error').forEach((error) => { error.hidden = true; error.textContent = ''; });
      form.querySelectorAll('[aria-invalid]').forEach((input) => input.removeAttribute('aria-invalid'));
      const body = Object.fromEntries(new FormData(form));
      button.disabled = true;
      button.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(form.action, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body), signal: AbortSignal.timeout(25000),
        });
        const result = await response.json();
        status.textContent = result.message || 'Your message could not be sent. Please try again.';
        status.dataset.success = String(response.ok);
        status.hidden = false;
        if (response.ok) form.reset();
        let firstInvalid: HTMLElement | null = null;
        if (result.errors) {
          for (const [name, message] of Object.entries(result.errors)) {
            if (!['name', 'email', 'company', 'message'].includes(name)) continue;
            const input = document.getElementById(`contact-${name}`);
            const error = document.getElementById(`${name}-error`);
            if (input && error) {
              input.setAttribute('aria-invalid', 'true');
              error.textContent = String(message);
              error.hidden = false;
              firstInvalid ??= input;
            }
          }
        }
        (firstInvalid ?? status).focus();
      } catch {
        status.textContent = 'We couldn’t confirm that your message was sent. Please check your connection and try again.';
        status.dataset.success = 'false';
        status.hidden = false;
        status.focus();
      } finally {
        button.disabled = false;
        button.textContent = 'Send Project Details';
        form.removeAttribute('aria-busy');
        const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
        turnstile?.reset();
      }
    });
  }
</script>
<style>
  .contact-form { position: relative; display: flex; flex-direction: column; gap: 1.15rem; padding: 2.5rem; border-radius: 1rem; background: var(--card); color: var(--card-foreground); }
  .field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  label { font-size: 0.875rem; font-weight: 500; }
  label span { color: var(--muted-foreground); font-weight: 400; }
  input, textarea { width: 100%; min-width: 0; border: 1px solid var(--input); border-radius: var(--radius); background: var(--card); color: var(--foreground); padding: 0.7rem 0.85rem; line-height: 1.5; }
  input { min-height: 3rem; }
  textarea { resize: vertical; min-height: 9rem; }
  textarea::placeholder { color: var(--muted-foreground); opacity: 1; }
  [aria-invalid='true'] { border-color: var(--destructive); }
  .field-error { color: var(--destructive); font-size: 0.8125rem; }
  .button { align-self: flex-start; }
  .privacy-note { font-size: 0.75rem; line-height: 1.6; color: var(--muted-foreground); }
  .form-status { font-size: 0.9375rem; color: var(--destructive); }
  .form-status[data-success='true'] { color: var(--accent); }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 1000px) { .contact-form { padding: 1.75rem; } .field-pair { grid-template-columns: 1fr; gap: 1.15rem; } }
  @media (max-width: 700px) { .contact-form { padding: 1.5rem; } }
  @media (max-width: 380px) { .contact-form { padding: 1.125rem; } }
</style>
