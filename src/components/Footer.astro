---
import Wordmark from './Wordmark.astro';
---
<footer class="site-footer container">
  <Wordmark compact />
  <nav aria-label="Footer navigation">
    <a href="/#services">Services</a><a href="/#about">About</a><a href="/#contact">Contact</a><a href="/privacy/">Privacy</a>
  </nav>
  <p>© {new Date().getFullYear()} MAGNESS Software Consulting</p>
</footer>
<style>
  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 4rem 3rem; }
  nav { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 0.8125rem; }
  p { font-size: 0.75rem; color: var(--muted-foreground); }
  @media (max-width: 900px) { .site-footer { flex-wrap: wrap; } }
  @media (max-width: 700px) { .site-footer { align-items: flex-start; flex-direction: column; padding-block: 3rem 2rem; gap: 1.5rem; } }
</style>
