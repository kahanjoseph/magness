---
import Wordmark from './Wordmark.astro';
const onHome = Astro.url.pathname === '/';
const section = (id: string) => `${onHome ? '' : '/'}#${id}`;
const navLink = 'nav-link relative py-[calc(.5rem*var(--space-scale))] text-sm font-medium text-[var(--nav-text)] no-underline transition-colors duration-(--duration-normal) after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-[var(--nav-accent)] after:transition-transform hover:after:scale-x-100 focus-visible:after:scale-x-100 max-[700px]:border-b max-[700px]:border-[var(--nav-line)] max-[700px]:py-[calc(.8rem*var(--space-scale))] max-[700px]:text-base';
---
<header class="site-header group/header sticky top-0 z-50 border-b border-transparent bg-background text-[var(--nav-text)] transition-[background,color,border-color,box-shadow] duration-(--duration-normal) [--nav-text:var(--foreground)] [--nav-muted:var(--muted-foreground)] [--nav-line:var(--border)] [--nav-accent:var(--accent)] [--nav-hover-bg:var(--foreground)] [--nav-hover-text:var(--background)] [&.lifted:not(.scrolled)]:border-border [&.scrolled]:border-inverse-border [&.scrolled]:bg-primary [&.scrolled]:shadow-[var(--shadow-header)] [&.scrolled]:[--nav-text:var(--primary-foreground)] [&.scrolled]:[--nav-muted:var(--inverse-muted)] [&.scrolled]:[--nav-line:var(--inverse-border)] [&.scrolled]:[--nav-accent:var(--brand-bright)] [&.scrolled]:[--nav-hover-bg:var(--brand-bright)] [&.scrolled]:[--nav-hover-text:var(--primary)] [&_.wordmark]:text-[var(--nav-text)] [&_.descriptor]:text-[var(--nav-muted)]">
  <div class="header-inner container flex min-h-(--header-height) items-center justify-between gap-(--space-lg) max-[700px]:flex-wrap max-[700px]:gap-(--space-md) max-[700px]:py-(--space-md)">
  <Wordmark />
  <button class="menu-toggle group/menu hidden items-center gap-[calc(.8rem*var(--space-scale))] rounded-md border border-[var(--nav-line)] bg-transparent px-[calc(.8rem*var(--space-scale))] py-[calc(.65rem*var(--space-scale))] text-[.8125rem] text-[var(--nav-text)] max-[700px]:inline-flex" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>
    <span class="menu-label">Menu</span><span class="menu-icon grid gap-[5px]" aria-hidden="true"><i class="h-[1.5px] w-4 bg-current transition-transform group-aria-expanded/menu:translate-y-[3.25px] group-aria-expanded/menu:rotate-45"></i><i class="h-[1.5px] w-4 bg-current transition-transform group-aria-expanded/menu:-translate-y-[3.25px] group-aria-expanded/menu:-rotate-45"></i></span>
  </button>
  <nav id="primary-navigation" class="flex items-center gap-[calc(2rem*var(--space-scale))] max-[700px]:w-full max-[700px]:flex-col max-[700px]:items-stretch max-[700px]:gap-[calc(1.25rem*var(--space-scale))] max-[700px]:py-(--space-md) max-[700px]:data-[enhanced=true]:hidden max-[700px]:data-[open=true]:flex" aria-label="Primary navigation">
    <div class="nav-links flex items-center gap-[calc(2.1rem*var(--space-scale))] border-r border-[var(--nav-line)] pr-[calc(2rem*var(--space-scale))] max-[700px]:flex-col max-[700px]:items-stretch max-[700px]:gap-0 max-[700px]:border-0 max-[700px]:pr-0"><a class={navLink} href={section('services')}>Services</a><a class={navLink} href={section('about')}>About</a><a class={navLink} href={section('contact')}>Contact</a></div>
    <a class="header-cta inline-flex min-h-12 items-center justify-between gap-[calc(1.4rem*var(--space-scale))] rounded-md border border-[var(--nav-line)] px-(--space-md) py-[calc(.7rem*var(--space-scale))] text-[.8125rem] font-semibold text-[var(--nav-text)] no-underline transition-colors duration-(--duration-fast) hover:border-[var(--nav-hover-bg)] hover:bg-[var(--nav-hover-bg)] hover:text-[var(--nav-hover-text)] hover:[&_span]:text-[var(--nav-hover-text)] max-[700px]:w-full" href={section('contact')}>Discuss your project <span class="text-[1.1rem] text-[var(--nav-accent)]" aria-hidden="true">↗</span></a>
  </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  const header = document.querySelector<HTMLElement>('.site-header');
  // Light header with a hairline once the page moves; it turns navy when the
  // hero has scrolled under it, so the change arrives with the navy services panel.
  const hero = document.querySelector<HTMLElement>('.hero');
  const updateHeader = () => {
    header?.classList.toggle('lifted', window.scrollY > 8);
    if (!hero) header?.classList.toggle('scrolled', window.scrollY > 20);
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
  if (hero && header) {
    new IntersectionObserver(([entry]) => header.classList.toggle('scrolled', !entry.isIntersecting), {
      rootMargin: `-${header.offsetHeight}px 0px 0px 0px`,
    }).observe(hero);
  }
  if (toggle && nav) {
    toggle.hidden = false;
    nav.dataset.enhanced = 'true';
    const close = () => { toggle.setAttribute('aria-expanded', 'false'); nav.dataset.open = 'false'; toggle.querySelector('.menu-label')!.textContent = 'Menu'; };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
      toggle.querySelector('.menu-label')!.textContent = open ? 'Close' : 'Menu';
    });
    nav.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) close(); });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); }
    });
    document.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('.site-header')) close();
    });
    matchMedia('(min-width: 701px)').addEventListener('change', close);
  }
</script>
