# Copy to .env. Never commit credentials. Restart the server after changes.
# Sending stays unavailable until all three email settings are supplied.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a sender on a domain verified in Resend, e.g. MAGNESS <website@magness.dev>.
MAIL_FROM=
# Your inbox; this may be a Gmail address.
CONTACT_TO=
# Public origin allowed to submit the form in production (no trailing slash).
SITE_URL=https://magness.dev

# Keep disabled until email, both Turnstile keys, and the tunnel are configured.
# The public flag and site key are embedded at build time. Rebuild after changes.
PUBLIC_CONTACT_FORM_ENABLED=false
CONTACT_FORM_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable only when the production listener is bound to 127.0.0.1 and reached
# exclusively through Cloudflare Tunnel. Never trust this header on a public listener.
TRUST_CLOUDFLARE_IP=false
